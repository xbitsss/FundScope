# Copy to .env for local publishing. Keep real secrets in .env or GitHub Secrets only.
DATA_PASSPHRASE=
ENCRYPT_DATA=true
HOSTING_TARGET=github-pages
PUBLIC_BASE_PATH=/FundScope/
GITHUB_REPOSITORY=xbitsss/FundScope
GITHUB_REPOSITORY_VISIBILITY=public
DATA_RELEASE_TAG=data-latest
DATA_DIR=.data
RISK_FREE_RATE=6.5
MAX_SITE_SIZE_MB=950
MAX_DB_SIZE_MB=1800
ETL_TIME_BUDGET_MINUTES=45
ETL_BATCH_SIZE=3000
HTTP_CONCURRENCY=3
HTTP_INTERVAL_MS=150
HTTP_TIMEOUT_MS=20000
HTTP_MAX_RETRIES=4
# Optional: NTFY_TOPIC_URL=https://ntfy.sh/your-private-topic
